# Let browsers reuse fonts, styles, scripts and media between pages.
/wp-content/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/wp-includes/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# The docs' agent files are small and change with every build.
/docs/llms.txt
  Cache-Control: public, max-age=300
/docs/llms-full.txt
  Cache-Control: public, max-age=300
/docs/index.json
  Cache-Control: public, max-age=300
/docs/search-index.json
  Cache-Control: public, max-age=300
