# WordPress core: Studio installs it when it creates the site.
/wp-admin/
/wp-includes/
/*.php
/license.txt
/readme.html

# Files Studio generates for each machine.
/STUDIO.md
/wp-content/db.php
/wp-content/mu-plugins/
/wp-content/upgrade/
/wp-content/index.php
/wp-content/plugins/*
!/wp-content/plugins/studio-docs/
/wp-content/plugins/studio-docs/tests/.deps/
/wp-content/themes/index.php
/wp-content/themes/twentytwenty*/
/wp-content/database/*.sqlite-wal
/wp-content/database/*.sqlite-shm
/wp-content/database/*-journal

# Agent scratch files.
/tmp/

# Output of scripts/build-site.sh: the staged docs (build/docs) and the static site (dist).
/build/
/dist/
/node_modules/

# Screenshots the docs importer sideloads on every build (scripts/build-docs-manifest.mjs + wp-docs import).
/wp-content/uploads/docs/

# Video project build output.
/video/node_modules/
/video/out/
.DS_Store
.spacefast/state.json
/.spacefast-*
.spacefast/.spacefast-*
.spacefast/.space-link-*.tmp
