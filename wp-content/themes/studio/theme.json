{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1240px"
		},
		"useRootPaddingAwareAlignments": true,
		"color": {
			"palette": [
				{
					"slug": "primary",
					"color": "#3858e9",
					"name": "Primary"
				},
				{
					"slug": "primary-strong",
					"color": "#2741c7",
					"name": "Primary Strong"
				},
				{
					"slug": "background",
					"color": "#ffffff",
					"name": "Background"
				},
				{
					"slug": "text",
					"color": "#0f1222",
					"name": "Text"
				},
				{
					"slug": "muted",
					"color": "#6b7080",
					"name": "Muted"
				},
				{
					"slug": "rule",
					"color": "#e8eaf0",
					"name": "Rule"
				},
				{
					"slug": "surface",
					"color": "#f6f7fb",
					"name": "Surface"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "instrument-sans",
					"name": "Instrument Sans",
					"fontFamily": "\"Instrument Sans\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Instrument Sans",
							"fontStyle": "normal",
							"fontWeight": "400 600",
							"src": [
								"file:./assets/fonts/instrument-sans/instrument-sans-400-600-latin-ext.woff2"
							],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF"
						},
						{
							"fontFamily": "Instrument Sans",
							"fontStyle": "normal",
							"fontWeight": "400 600",
							"src": [
								"file:./assets/fonts/instrument-sans/instrument-sans-400-600-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				},
				{
					"slug": "jetbrains-mono",
					"name": "JetBrains Mono",
					"fontFamily": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace",
					"fontFace": [
						{
							"fontFamily": "JetBrains Mono",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/jetbrains-mono/jetbrains-mono-400-cyrillic-ext.woff2"
							],
							"unicodeRange": "U+0460-052F, U+1C80-1C8A, U+20B4, U+2DE0-2DFF, U+A640-A69F, U+FE2E-FE2F"
						},
						{
							"fontFamily": "JetBrains Mono",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/jetbrains-mono/jetbrains-mono-400-cyrillic.woff2"
							],
							"unicodeRange": "U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116"
						},
						{
							"fontFamily": "JetBrains Mono",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/jetbrains-mono/jetbrains-mono-400-greek.woff2"
							],
							"unicodeRange": "U+0370-0377, U+037A-037F, U+0384-038A, U+038C, U+038E-03A1, U+03A3-03FF"
						},
						{
							"fontFamily": "JetBrains Mono",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/jetbrains-mono/jetbrains-mono-400-vietnamese.woff2"
							],
							"unicodeRange": "U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB"
						},
						{
							"fontFamily": "JetBrains Mono",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/jetbrains-mono/jetbrains-mono-400-latin-ext.woff2"
							],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF"
						},
						{
							"fontFamily": "JetBrains Mono",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/jetbrains-mono/jetbrains-mono-400-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "display",
					"size": "clamp(2.75rem, 7vw, 5.75rem)",
					"name": "Display"
				},
				{
					"slug": "headline",
					"size": "clamp(2rem, 4vw, 3rem)",
					"name": "Headline"
				},
				{
					"slug": "body",
					"size": "1.0625rem",
					"name": "Body"
				},
				{
					"slug": "label",
					"size": "0.8125rem",
					"name": "Label"
				},
				{
					"slug": "code",
					"size": "0.9375rem",
					"name": "Code"
				}
			]
		},
		"spacing": {
			"spacingSizes": [
				{
					"slug": "xs",
					"size": "8px",
					"name": "Extra small"
				},
				{
					"slug": "sm",
					"size": "16px",
					"name": "Small"
				},
				{
					"slug": "md",
					"size": "32px",
					"name": "Medium"
				},
				{
					"slug": "lg",
					"size": "64px",
					"name": "Large"
				},
				{
					"slug": "xl",
					"size": "120px",
					"name": "Extra large"
				}
			]
		},
		"custom": {
			"rounded": {
				"sm": "8px",
				"md": "14px",
				"pill": "999px"
			}
		}
	},
	"styles": {
		"spacing": {
			"padding": {
				"top": "0px",
				"right": "clamp(1.25rem, 5vw, 3rem)",
				"bottom": "0px",
				"left": "clamp(1.25rem, 5vw, 3rem)"
			}
		},
		"color": {
			"background": "var:preset|color|background",
			"text": "var:preset|color|text"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|instrument-sans",
			"fontSize": "var:preset|font-size|body",
			"fontWeight": "400",
			"lineHeight": "1.6"
		},
		"blocks": {
			"core/code": {
				"color": {
					"background": "var:preset|color|text",
					"text": "var:preset|color|rule"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|jetbrains-mono",
					"fontSize": "var:preset|font-size|code",
					"lineHeight": "1.6"
				},
				"border": {
					"radius": "14px"
				},
				"spacing": {
					"padding": {
						"top": "18px",
						"right": "22px",
						"bottom": "18px",
						"left": "22px"
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "0.9375rem",
					"fontWeight": "500"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|text"
						},
						":hover": {
							"color": {
								"text": "var:preset|color|primary"
							}
						}
					}
				}
			},
			"core/site-title": {
				"typography": {
					"fontSize": "1.0625rem",
					"fontWeight": "600",
					"letterSpacing": "-0.02em"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|text"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			}
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var:preset|color|text"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|instrument-sans",
					"fontWeight": "600",
					"lineHeight": "1.08",
					"letterSpacing": "-0.03em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|display",
					"lineHeight": "1",
					"letterSpacing": "-0.04em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|headline"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "1.3125rem",
					"letterSpacing": "-0.02em",
					"lineHeight": "1.25"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "1.0625rem",
					"letterSpacing": "-0.01em",
					"lineHeight": "1.35"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|primary"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|primary-strong"
					}
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|primary",
					"text": "#ffffff"
				},
				"border": {
					"radius": "999px"
				},
				"spacing": {
					"padding": {
						"top": "14px",
						"right": "26px",
						"bottom": "14px",
						"left": "26px"
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|instrument-sans",
					"fontSize": "0.9375rem",
					"fontWeight": "500",
					"lineHeight": "1.2"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|primary-strong",
						"text": "#ffffff"
					}
				},
				":focus": {
					"color": {
						"background": "var:preset|color|primary-strong",
						"text": "#ffffff"
					}
				}
			}
		}
	},
	"customTemplates": [
		{
			"name": "page-no-title",
			"title": "Page (no title)",
			"postTypes": [
				"page"
			]
		}
	]
}
