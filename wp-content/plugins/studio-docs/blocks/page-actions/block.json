{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "studio-docs/page-actions",
	"version": "1.0.1",
	"title": "Docs Page Actions",
	"category": "studio-docs",
	"icon": "admin-links",
	"description": "Copy or open the current page's Markdown and navigate to the previous or next docs page.",
	"textdomain": "studio-docs",
	"usesContext": [ "postId", "postType" ],
	"attributes": {
		"variant": {
			"type": "string",
			"enum": [ "header", "rail" ],
			"default": "header"
		}
	},
	"supports": {
		"html": false
	},
	"editorScript": "file:./index.js",
	"style": "file:./style.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
